# =============================================================================
# ProcessHub environment configuration
# Copy to `.env` (cp .env.example .env) and change every value marked CHANGE ME.
# Never commit the real .env file.
# =============================================================================

# ---- General ---------------------------------------------------------------
# development | test | production
NODE_ENV=production
# Port the web UI is published on (http://localhost:WEB_PORT)
WEB_PORT=8080
# Port the API listens on inside its container
PORT=3000

# ---- Database (PostgreSQL 16) ------------------------------------------------
POSTGRES_USER=processhub
# CHANGE ME
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=processhub
# Connection string used by the API when run outside Docker (e.g. `pnpm dev:api`).
# Docker Compose builds it from the POSTGRES_* values above and ignores this line.
DATABASE_URL=postgresql://processhub:change-me-db-password@localhost:5432/processhub?schema=public

# ---- Authentication ------------------------------------------------------------
# Secret used to sign JWT access tokens (HS256). At least 32 random characters.
# Generate with: openssl rand -base64 48
# Leave empty with Docker Compose to auto-generate one on first start (kept in the api-data volume).
JWT_ACCESS_SECRET=
# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days (refresh tokens rotate on every use)
REFRESH_TOKEN_TTL_DAYS=7
# Send cookies with the Secure flag. Browsers accept Secure cookies on http://localhost;
# set to false only when serving over plain HTTP on a non-localhost host (not recommended).
COOKIE_SECURE=true
# Comma-separated list of allowed browser origins (CORS). Must match the URL users open.
CORS_ORIGINS=http://localhost:8080
# Number of reverse proxies in front of the API (used for client IPs in audit/rate limits)
TRUST_PROXY=1
# Maximum JSON request body size (BPMN models are sent as JSON)
BODY_LIMIT=6mb

# ---- Account lockout & password policy ----------------------------------------
# Failed logins before the account is locked
LOGIN_MAX_ATTEMPTS=5
# Lock duration in minutes
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false

# ---- Rate limiting -------------------------------------------------------------
# Window length in seconds
RATE_LIMIT_TTL_SECONDS=60
# Max requests per client IP per window (all endpoints)
RATE_LIMIT_MAX=300
# Max login / refresh / change-password attempts per client IP per window
LOGIN_RATE_LIMIT_MAX=10

# ---- File storage (MinIO, S3-compatible) -----------------------------------------
# Container image for MinIO (see docs/DECISIONS.md D-009 before changing it)
MINIO_IMAGE=bitnamilegacy/minio:2025.4.22
# Host/port the API uses to reach MinIO (Docker Compose always uses minio:9000)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Root credentials of the bundled MinIO container (also used by the API)   CHANGE ME
MINIO_ACCESS_KEY=processhub
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=processhub

# ---- API documentation ---------------------------------------------------------
# Expose Swagger UI at /api/docs (keep false in production)
ENABLE_SWAGGER=false

# ---- Seed data -----------------------------------------------------------------
# Run migrations + seed automatically when the API container starts
SEED_ON_START=true
# Create demo departments, processes, roles/systems and BPMN models (only into an empty repository)
SEED_DEMO_DATA=true
# Initial Super Admin (created once; changing these later does not change an existing user)
SEED_ADMIN_EMAIL=admin@processhub.local
# Must satisfy the password policy above.   CHANGE ME
SEED_ADMIN_PASSWORD=ChangeMe-Admin1
SEED_ADMIN_NAME_EN=System Administrator
SEED_ADMIN_NAME_AR=مدير النظام
# en | ar
SEED_ADMIN_LOCALE=en
# Organisation defaults (editable later in Settings)
SEED_ORG_NAME_EN=ProcessHub
SEED_ORG_NAME_AR=بروسس هب
SEED_DEFAULT_LOCALE=en
# Demo users created with the demo data (one per role), all with this password:
#   viewer@processhub.local    Viewer (Knowledge Portal only)
#   reviewer@processhub.local  Reviewer
#   owner@processhub.local     Process Owner
#   modeler@processhub.local   Modeler / Editor
# Must satisfy the password policy.   CHANGE ME (or set SEED_DEMO_DATA=false in production)
SEED_DEMO_PASSWORD=Demo-Password1
# Domain of the demo users' email addresses
SEED_DEMO_EMAIL_DOMAIN=processhub.local
# Point the email settings at a local mail catcher on first start (Docker Compose: Mailpit).
# Set empty to configure your SMTP server later in Settings → Email.
SEED_SMTP_HOST=mailpit
SEED_SMTP_PORT=1025
SEED_SMTP_FROM=processhub@processhub.local

# ---- Integrations (GitHub / GitLab sync) ------------------------------------------
# 32-byte key (base64) for AES-256-GCM encryption of GitHub/GitLab tokens at rest.
# Generate with: openssl rand -base64 32
# Leave empty with Docker Compose to auto-generate one on first start (kept in the api-data volume).
# It also encrypts the SMTP password (Settings → Email).
# IMPORTANT: back this key up together with the database. If it is lost or changes, stored
# tokens and passwords can no longer be decrypted and must be entered again.
INTEGRATIONS_ENCRYPTION_KEY=
# Timeout for each call to the GitHub / GitLab API, in milliseconds
GIT_HTTP_TIMEOUT_MS=20000

# ---- Notifications & governance ---------------------------------------------------
# Public URL of ProcessHub (used for links in notification emails)
APP_URL=http://localhost:8080
# How often reminders are checked (review dates, overdue reviews), in minutes; 0 = off
SCHEDULER_INTERVAL_MINUTES=60
# Timeout for one SMTP delivery, in milliseconds (SMTP server itself: Settings → Email)
SMTP_TIMEOUT_MS=15000
# Port of the Mailpit web UI (local mail catcher in Docker Compose): http://localhost:8025
MAILPIT_UI_PORT=8025
