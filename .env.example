# =============================================================================
# ProcessHub environment configuration
# Copy to `.env` (cp .env.example .env) and change every value marked CHANGE ME.
# Never commit the real .env file.
# =============================================================================

# ---- General ---------------------------------------------------------------
# development | test | production
NODE_ENV=production
# Port the web UI is published on (http://localhost:WEB_PORT)
WEB_PORT=8080
# Port the API listens on inside its container
PORT=3000

# ---- Database (PostgreSQL 16) ------------------------------------------------
POSTGRES_USER=processhub
# CHANGE ME
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=processhub
# Connection string used by the API. In Docker Compose the host is `postgres`.
DATABASE_URL=postgresql://processhub:change-me-db-password@postgres:5432/processhub?schema=public

# ---- Authentication ------------------------------------------------------------
# Secret used to sign JWT access tokens (HS256). At least 32 random characters.
# Generate with: openssl rand -base64 48            CHANGE ME
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days (refresh tokens rotate on every use)
REFRESH_TOKEN_TTL_DAYS=7
# Send cookies with the Secure flag. Browsers accept Secure cookies on http://localhost;
# set to false only when serving over plain HTTP on a non-localhost host (not recommended).
COOKIE_SECURE=true
# Comma-separated list of allowed browser origins (CORS). Must match the URL users open.
CORS_ORIGINS=http://localhost:8080
# Number of reverse proxies in front of the API (used for client IPs in audit/rate limits)
TRUST_PROXY=1
# Maximum JSON request body size (BPMN models are sent as JSON)
BODY_LIMIT=6mb

# ---- Account lockout & password policy ----------------------------------------
# Failed logins before the account is locked
LOGIN_MAX_ATTEMPTS=5
# Lock duration in minutes
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false

# ---- Rate limiting -------------------------------------------------------------
# Window length in seconds
RATE_LIMIT_TTL_SECONDS=60
# Max requests per client IP per window (all endpoints)
RATE_LIMIT_MAX=300
# Max login / refresh / change-password attempts per client IP per window
LOGIN_RATE_LIMIT_MAX=10

# ---- File storage (MinIO, S3-compatible) -----------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Root credentials of the bundled MinIO container (also used by the API)   CHANGE ME
MINIO_ACCESS_KEY=processhub
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=processhub

# ---- API documentation ---------------------------------------------------------
# Expose Swagger UI at /api/docs (keep false in production)
ENABLE_SWAGGER=false

# ---- Seed data -----------------------------------------------------------------
# Run migrations + seed automatically when the API container starts
SEED_ON_START=true
# Create demo departments, processes, roles/systems and BPMN models (only into an empty repository)
SEED_DEMO_DATA=true
# Initial Super Admin (created once; changing these later does not change an existing user)
SEED_ADMIN_EMAIL=admin@processhub.local
# Must satisfy the password policy above.   CHANGE ME
SEED_ADMIN_PASSWORD=ChangeMe-Admin1
SEED_ADMIN_NAME_EN=System Administrator
SEED_ADMIN_NAME_AR=مدير النظام
# en | ar
SEED_ADMIN_LOCALE=en
# Organisation defaults (editable later in Settings)
SEED_ORG_NAME_EN=ProcessHub
SEED_ORG_NAME_AR=بروسس هب
SEED_DEFAULT_LOCALE=en

# ---- Phase 2 (not used yet) -------------------------------------------------------
# 32-byte key (base64) for AES-256-GCM encryption of GitHub/GitLab tokens at rest.
# Generate with: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=
