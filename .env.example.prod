# =============================================================================
# ProcessHub — PRODUCTION configuration (docker-compose.prod.yml, docs/DEPLOYMENT.md)
#
#   cp .env.example.prod .env
#   ./scripts/generate-secrets.sh      # fills every __GENERATE__ value with a random secret
#   nano .env                          # set DOMAIN, CADDY_TLS and SEED_ADMIN_EMAIL
#
# The finished .env holds the keys that protect your data. Keep a copy in your password manager or
# vault: a backup can only be fully restored with the same JWT / encryption keys (DEPLOYMENT.md "Backups").
# Never commit .env, never send it by e-mail. File permissions: chmod 600 .env (the script does this).
# =============================================================================

# Use the production stack with plain `docker compose ...` commands (no -f needed).
COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_PROJECT_NAME=processhub

# ---- Domain and HTTPS -----------------------------------------------------------
# Host name users open in the browser (a DNS "A" record must point to this server). No https://.
DOMAIN=processhub.example.com
# How Caddy gets the HTTPS certificate:
#   an e-mail address          free Let's Encrypt certificate, renewed automatically (server must be
#                              reachable from the internet on ports 80 and 443)
#   internal                   Caddy's own certificate authority (intranet only; browsers warn until the
#                              Caddy root certificate is installed on the PCs)
#   /certs/cert.pem /certs/key.pem   your company's certificate, files placed in deploy/certs/
CADDY_TLS=it-admin@example.com

# ---- Secrets (generated by scripts/generate-secrets.sh) -------------------------------
# Database password (letters and digits only, it is part of a connection URL)
POSTGRES_USER=processhub
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=processhub
# File storage credentials (used by the storage container and the API)
MINIO_ACCESS_KEY=processhub
MINIO_SECRET_KEY=__GENERATE__
MINIO_BUCKET=processhub
# Signs the login tokens. Changing it signs everybody out (nothing else is lost).
JWT_ACCESS_SECRET=__GENERATE__
# Encrypts stored integration secrets (GitHub/GitLab token, SMTP password, AI API key).
# If it is lost or changed, those secrets must be entered again in Settings.
INTEGRATIONS_ENCRYPTION_KEY=__GENERATE__

# ---- First administrator ------------------------------------------------------------
# Created on the first start only. Sign in with these, then change the password (profile menu).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=__GENERATE__
SEED_ADMIN_NAME_EN=System Administrator
SEED_ADMIN_NAME_AR=مدير النظام
# en | ar
SEED_ADMIN_LOCALE=en
SEED_ORG_NAME_EN=ProcessHub
SEED_ORG_NAME_AR=بروسس هب
SEED_DEFAULT_LOCALE=en
# Never create demo users and demo content in production.
SEED_DEMO_DATA=false
# Apply database updates and create the administrator when the API starts (keep true).
SEED_ON_START=true
# E-mail (SMTP) is configured in Settings → Email after the first sign-in.
SEED_SMTP_HOST=

# ---- Sign-in security -------------------------------------------------------------
# Access token 15 minutes, refresh token (session) 24 hours (rotated on every use)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
# Swagger UI at /api/docs — keep false in production
ENABLE_SWAGGER=false
# Extra browser origins allowed to call the API (default: https://DOMAIN only)
# CORS_ORIGINS=https://processhub.example.com

# ---- Integrations ---------------------------------------------------------------
# Internal hosts (company GitLab / SMTP in a private network) the integrations may reach, e.g.
# gitlab.corp.local,smtp.corp.local,10.20.0.0/16. Empty = only public addresses (SSRF protection).
OUTBOUND_ALLOWED_HOSTS=
GIT_HTTP_TIMEOUT_MS=20000
# Timeout for calls to Salesforce (optional KPI link, Settings → Integrations → Salesforce).
SALESFORCE_HTTP_TIMEOUT_MS=30000
SMTP_TIMEOUT_MS=15000
AI_HTTP_TIMEOUT_MS=180000

# ---- Single sign-on (Settings → Authentication) ----------------------------------------
# Redirect URI to register at Entra ID / your OIDC provider: https://DOMAIN/api/v1/auth/sso/callback
# Emergency switch: true re-enables password sign-in for everyone when it was turned off in
# Settings → Authentication and the break-glass account cannot be used. Remove again afterwards.
AUTH_FORCE_LOCAL_LOGIN=false
# Reminder checks (review dates, overdue reviews), in minutes
SCHEDULER_INTERVAL_MINUTES=60

# ---- Backups (scripts/backup.sh) ------------------------------------------------------
# Folder for backups on the server (ideally a separate data disk) and how many days to keep them.
BACKUP_DIR=/var/backups/processhub
BACKUP_KEEP_DAYS=14

# ---- Server size (DEPLOYMENT.md "Server sizing") ----------------------------------------
# Defaults fit 4 vCPU / 8 GB RAM (up to ~250 users). For 8 vCPU / 16 GB (up to 500 users) use e.g.
# API_MEMORY=4G, API_NODE_HEAP_MB=3072, POSTGRES_MEMORY=6G, PG_SHARED_BUFFERS=2GB,
# PG_EFFECTIVE_CACHE_SIZE=6GB.
# API_CPUS=2
# API_MEMORY=2G
# API_NODE_HEAP_MB=1536
# POSTGRES_CPUS=2
# POSTGRES_MEMORY=2G
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# PG_WORK_MEM=16MB
# PG_MAX_CONNECTIONS=100
# STORAGE_MEMORY=512M
# Docker log rotation per container: size of one file and number of files kept
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=5

# ---- Images ------------------------------------------------------------------
# Tag for the images built from this folder (e.g. the release you checked out)
PROCESSHUB_VERSION=latest
# Third-party images, pinned. Change only when upgrading on purpose (DEPLOYMENT.md "Updates").
# CADDY_IMAGE=caddy:2.11-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# STORAGE_IMAGE=versity/versitygw:v1.9.0
