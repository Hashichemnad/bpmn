{
  "name": "@processhub/api",
  "version": "0.1.0",
  "private": true,
  "description": "ProcessHub REST API (NestJS + Prisma)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "NODE_OPTIONS=--max-old-space-size=4096 jest --runInBand --selectProjects e2e",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "seed:prod": "node dist/prisma/seed.js"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "~6.19.0",
    "@processhub/shared": "workspace:*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "docx": "^9.15.0",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsdom": "^26.1.0",
    "minio": "^8.0.5",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.16",
    "openid-client": "6.8.8",
    "otpauth": "9.5.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "saxes": "^6.0.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@types/turndown": "^5.0.6",
    "jest": "^29.7.0",
    "jose": "6.2.13",
    "jszip": "^3.10.2",
    "prisma": "~6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
