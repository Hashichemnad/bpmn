// ProcessHub data model — Phase 1 core (see CLAUDE.md §9), Phase 2 wiki, versions and Git sync,
// Phase 3 governance (reviews, publications, comments, notifications) and Knowledge Portal.

generator client {
  provider      = "prisma-client-js"
  // native for local development; musl targets for the node:22-alpine Docker image (amd64 / arm64)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProcessCategory {
  MANAGEMENT
  CORE
  SUPPORT
}

enum ProcessStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ObjectType {
  ROLE
  SYSTEM
  DOCUMENT
  RISK
  CONTROL
  KPI
  TERM
  REQUIREMENT
}

/// Dictionary terms are proposed as DRAFT and approved; other library objects are APPROVED.
enum ObjectStatus {
  DRAFT
  APPROVED
}

enum SpaceAccessLevel {
  VIEW
  EDIT
}

enum SpacePrincipalType {
  USER
  ROLE
  DEPARTMENT
}

enum PageLinkTarget {
  PROCESS
  OBJECT
}

enum GitEntityType {
  PROCESS
  PAGE
}

enum GitSyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ContentType {
  PROCESS
  PAGE
  DIAGRAM
}

enum ReviewStatus {
  IN_PROGRESS
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  WITHDRAWN
}

enum ReviewTaskStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SKIPPED
}

enum FeedbackKind {
  IMPROVEMENT
  OUTDATED
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum LinkRelation {
  PERFORMS
  SUPPORTS
  INPUT
  OUTPUT
  MITIGATES
  MEASURES
  NAMED
  REQUIRES
}

// ---------- Risk & Compliance (M10, Phase 4.1 — D-089) ----------

enum GrcStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum RiskResponse {
  ACCEPT
  AVOID
  MITIGATE
  TRANSFER
}

enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
}

enum ControlNature {
  MANUAL
  AUTOMATED
  IT_DEPENDENT_MANUAL
}

enum ControlFrequency {
  PER_TRANSACTION
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  AD_HOC
}

enum ControlEffectiveness {
  EFFECTIVE
  PARTLY
  NOT_EFFECTIVE
  NOT_ASSESSED
}

enum RequirementLevel {
  SOURCE
  SECTION
  CLAUSE
}

enum GrcActivityKind {
  CREATED
  ASSESSMENT
  STATUS
  COMMENT
}

model User {
  id                String      @id @default(uuid()) @db.Uuid
  email             String      @unique
  nameEn            String      @default("")
  nameAr            String      @default("")
  passwordHash      String
  locale            String      @default("en")
  status            UserStatus  @default(ACTIVE)
  departmentId      String?     @db.Uuid
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  failedLoginCount  Int         @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  /// Per notification type: { inApp, email }. Missing types use the defaults (both on).
  notificationPrefs Json        @default("{}")
  /// Single sign-on identity (OIDC issuer + subject); set on the first SSO sign-in.
  ssoIssuer         String?
  ssoSubject        String?
  /// TOTP two-factor: secret (AES-256-GCM), pending secret during enrolment, last accepted time step.
  totpSecretSealed  String?
  totpPendingSealed String?
  totpEnabledAt     DateTime?
  totpLastStep      Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdById       String?     @db.Uuid
  updatedById       String?     @db.Uuid
  deletedAt         DateTime?

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  ownedProcesses    Process[]               @relation("ProcessOwner")
  ownedSpaces       Space[]                 @relation("SpaceOwner")
  auditLogs         AuditLog[]
  pageDrafts        PageDraft[]
  ownedPages        Page[]                  @relation("PageOwner")
  jobRoles          UserJobRole[]
  notifications     Notification[]
  aiUsage           AiUsage[]
  recoveryCodes     MfaRecoveryCode[]
  ownedObjects      RepoObject[]            @relation("ObjectOwner")
  grcActivities     GrcActivity[]
  assuranceEvents   AssuranceEvent[]        @relation("AssuranceEventAuthor")
  appsOwned         Application[]           @relation("AppBusinessOwner")
  appsIt            Application[]           @relation("AppItOwner")
  interfacesOwned   AppInterface[]          @relation("InterfaceOwner")
  dataObjectsOwned  DataObject[]            @relation("DataObjectOwner")
  capabilitiesOwned Capability[]            @relation("CapabilityOwner")
  objectivesOwned   StrategicObjective[]    @relation("ObjectiveOwner")
  ownedDiagrams     Diagram[]               @relation("DiagramOwner")
  eventLogs         EventLog[]              @relation("EventLogOwner")
  eventLogGrants    EventLogGrant[]         @relation("EventLogGrants")
  miningTemplates   MiningMappingTemplate[] @relation("MiningTemplateOwner")
  miningPresets     MiningFilterPreset[]    @relation("MiningPresetUser")

  @@unique([ssoIssuer, ssoSubject])
  @@index([departmentId])
  @@index([status])
}

/// Single-use 2FA recovery codes (SHA-256 of the normalised code; the codes are random, 80 bits).
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  nameEn      String
  nameAr      String
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// Refresh tokens are stored hashed and rotated on every use.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// All tokens issued from one login share a family; reuse of a rotated token revokes the family.
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([familyId])
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  code        String?
  /// Head of the department: overdue issues and actions of its staff are escalated to them (D-100).
  managerId   String?      @db.Uuid
  nameEn      String       @default("")
  nameAr      String       @default("")
  parentId    String?      @db.Uuid
  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentTree")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?      @db.Uuid
  updatedById String?      @db.Uuid
  deletedAt   DateTime?

  users        User[]
  processes    Process[]
  spaces       Space[]
  risks        Risk[]
  controls     Control[]
  requirements Requirement[]
  applications Application[]
  kpis         Kpi[]
  diagrams     Diagram[]
  eventLogs    EventLog[]

  @@index([parentId])
}

model Process {
  id            String          @id @default(uuid()) @db.Uuid
  code          String
  nameEn        String          @default("")
  nameAr        String          @default("")
  descriptionEn String          @default("")
  descriptionAr String          @default("")
  category      ProcessCategory
  status        ProcessStatus   @default(DRAFT)
  parentId      String?         @db.Uuid
  parent        Process?        @relation("ProcessTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Process[]       @relation("ProcessTree")
  ownerId       String?         @db.Uuid
  owner         User?           @relation("ProcessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  departmentId  String?         @db.Uuid
  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  level         Int             @default(1)
  sortOrder     Int             @default(0)
  /// Approval workflow for this process only (null = category / global default).
  workflowId    String?         @db.Uuid
  workflow      Workflow?       @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  /// Next periodic review of the published content.
  nextReviewAt  DateTime?
  /// The working model was produced by the AI assistant and not yet edited or approved by a person.
  aiGenerated   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String?         @db.Uuid
  updatedById   String?         @db.Uuid
  deletedAt     DateTime?

  model          ProcessModel?
  versions       ProcessVersion[]
  links          ObjectLink[]
  pageLinks      PageLink[]
  capabilities   CapabilityProcess[]
  calculatedKpis Kpi[]               @relation("KpiCalculatedProcess")
  diagrams       Diagram[]
  eventLogs      EventLog[]

  @@index([parentId, sortOrder])
  @@index([category])
  @@index([code])
}

/// Current working BPMN model of a process. Bilingual labels live inside the XML (ph:nameEn / ph:nameAr).
model ProcessModel {
  processId   String   @id @db.Uuid
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  bpmnXml     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
}

model ProcessVersion {
  id            String   @id @default(uuid()) @db.Uuid
  processId     String   @db.Uuid
  process       Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  versionNumber Int
  bpmnXml       String
  changeNote    String
  /// Optional label such as "v1.0 – approved by committee".
  label         String?
  /// Set when this version was created by restoring an older one.
  restoredFrom  Int?
  createdAt     DateTime @default(now())
  createdById   String?  @db.Uuid

  @@unique([processId, versionNumber])
}

model RepoObject {
  id            String       @id @default(uuid()) @db.Uuid
  type          ObjectType
  code          String?
  nameEn        String       @default("")
  nameAr        String       @default("")
  descriptionEn String       @default("")
  descriptionAr String       @default("")
  attributes    Json         @default("{}")
  /// Dictionary (B2): status, category, synonyms and owner of a term (D-083).
  status        ObjectStatus @default(APPROVED)
  category      String?
  synonymsEn    String[]     @default([])
  synonymsAr    String[]     @default([])
  ownerId       String?      @db.Uuid
  owner         User?        @relation("ObjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  approvedById  String?      @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String?      @db.Uuid
  updatedById   String?      @db.Uuid
  deletedAt     DateTime?

  links        ObjectLink[]
  diagramLinks DiagramLink[]
  pageLinks    PageLink[]
  users        UserJobRole[]
  published    PublishedLink[]

  /// Risk & Compliance details (one of them for RISK / CONTROL / REQUIREMENT objects, D-089).
  risk           Risk?
  control        Control?
  requirement    Requirement?
  /// IT system objects: the controls that run in or depend on them.
  systemControls Control[]     @relation("ControlSystem")
  grcActivities  GrcActivity[]
  grcChanges     GrcChange[]
  /// Application catalogue details of a SYSTEM object (Phase 4.3, D-107).
  application    Application?
  /// KPI details of a KPI object (Phase 4.3, D-111).
  kpi            Kpi?

  @@index([type, status])
}

/// Risk register entry; code, title, description and owner live on the RepoObject (type RISK).
model Risk {
  objectId           String       @id @db.Uuid
  object             RepoObject   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  /// Key of a configurable category (Setting `grc`).
  category           String
  causeEn            String       @default("")
  causeAr            String       @default("")
  consequenceEn      String       @default("")
  consequenceAr      String       @default("")
  departmentId       String?      @db.Uuid
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  inherentLikelihood Int
  inherentImpact     Int
  /// After controls; null = not assessed yet (the inherent rating stands).
  residualLikelihood Int?
  residualImpact     Int?
  response           RiskResponse @default(MITIGATE)
  status             GrcStatus    @default(DRAFT)
  nextReviewAt       DateTime?
  lastAssessedAt     DateTime?
  /// Last "review due" / "overdue" reminder (prevents repeats).
  reminderSentFor    DateTime?

  controls RiskControl[]
  /// Key risk indicators (Phase 4.3).
  kpis     KpiRisk[]

  @@index([status])
  @@index([departmentId])
  @@index([nextReviewAt])
}

/// Internal control; code, title, description and owner live on the RepoObject (type CONTROL).
model Control {
  objectId               String               @id @db.Uuid
  object                 RepoObject           @relation(fields: [objectId], references: [id], onDelete: Cascade)
  controlType            ControlType          @default(PREVENTIVE)
  nature                 ControlNature        @default(MANUAL)
  frequency              ControlFrequency     @default(PER_TRANSACTION)
  departmentId           String?              @db.Uuid
  department             Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  keyControl             Boolean              @default(false)
  systemId               String?              @db.Uuid
  system                 RepoObject?          @relation("ControlSystem", fields: [systemId], references: [id], onDelete: SetNull)
  effectiveness          ControlEffectiveness @default(NOT_ASSESSED)
  /// Conclusion of the last reviewed control test (Phase 4.2, D-099); NOT_ASSESSED until then.
  operatingEffectiveness ControlEffectiveness @default(NOT_ASSESSED)
  lastTestedAt           DateTime?
  status                 GrcStatus            @default(DRAFT)
  nextReviewAt           DateTime?
  lastAssessedAt         DateTime?
  reminderSentFor        DateTime?

  risks        RiskControl[]
  requirements RequirementControl[]
  testPlans    ControlTestPlan[]
  tests        ControlTest[]

  @@index([status])
  @@index([departmentId])
  @@index([nextReviewAt])
}

/// Regulation, law, policy, standard or internal rule: source document → section → clause.
/// Code, title, bilingual text (description) and owner live on the RepoObject (type REQUIREMENT).
model Requirement {
  objectId      String           @id @db.Uuid
  object        RepoObject       @relation(fields: [objectId], references: [id], onDelete: Cascade)
  level         RequirementLevel @default(SOURCE)
  parentId      String?          @db.Uuid
  parent        Requirement?     @relation("RequirementTree", fields: [parentId], references: [objectId], onDelete: SetNull)
  children      Requirement[]    @relation("RequirementTree")
  sourceRef     String           @default("")
  url           String?
  departmentId  String?          @db.Uuid
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  effectiveDate DateTime?
  status        GrcStatus        @default(ACTIVE)
  nextReviewAt  DateTime?

  controls RequirementControl[]

  @@index([parentId])
  @@index([status])
}

/// Risk "mitigated by" control.
model RiskControl {
  riskId      String   @db.Uuid
  risk        Risk     @relation(fields: [riskId], references: [objectId], onDelete: Cascade)
  controlId   String   @db.Uuid
  control     Control  @relation(fields: [controlId], references: [objectId], onDelete: Cascade)
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  @@id([riskId, controlId])
  @@index([controlId])
}

/// Requirement "satisfied by" control.
model RequirementControl {
  requirementId String      @db.Uuid
  requirement   Requirement @relation(fields: [requirementId], references: [objectId], onDelete: Cascade)
  controlId     String      @db.Uuid
  control       Control     @relation(fields: [controlId], references: [objectId], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  createdById   String?     @db.Uuid

  @@id([requirementId, controlId])
  @@index([controlId])
}

/// Assessment history and comments of a risk, control or requirement (timeline).
model GrcActivity {
  id          String          @id @default(uuid()) @db.Uuid
  objectId    String          @db.Uuid
  object      RepoObject      @relation(fields: [objectId], references: [id], onDelete: Cascade)
  kind        GrcActivityKind
  /// { field: { from, to } } for likelihood / impact / effectiveness / status changes.
  changes     Json            @default("{}")
  comment     String          @default("")
  createdAt   DateTime        @default(now())
  createdById String?         @db.Uuid
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([objectId, createdAt])
}

model ObjectLink {
  id            String       @id @default(uuid()) @db.Uuid
  processId     String       @db.Uuid
  process       Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  bpmnElementId String
  repoObjectId  String       @db.Uuid
  repoObject    RepoObject   @relation(fields: [repoObjectId], references: [id], onDelete: Cascade)
  relation      LinkRelation
  createdAt     DateTime     @default(now())
  createdById   String?      @db.Uuid

  @@unique([processId, bpmnElementId, repoObjectId, relation])
  @@index([repoObjectId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  /// Before/after summary of the change (never contains secrets).
  summary    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
}

model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

// ---------- Documentation wiki (M5) ----------

model Space {
  id             String      @id @default(uuid()) @db.Uuid
  /// Short immutable key (e.g. "QM"), used in Git paths.
  key            String      @unique
  nameEn         String      @default("")
  nameAr         String      @default("")
  descriptionEn  String      @default("")
  descriptionAr  String      @default("")
  icon           String      @default("book")
  ownerId        String?     @db.Uuid
  owner          User?       @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  departmentId   String?     @db.Uuid
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Restricted spaces are visible / editable only for the owner, docs managers and granted principals.
  viewRestricted Boolean     @default(false)
  editRestricted Boolean     @default(false)
  /// Default approval workflow for the pages of this space.
  workflowId     String?     @db.Uuid
  workflow       Workflow?   @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?     @db.Uuid
  updatedById    String?     @db.Uuid
  deletedAt      DateTime?

  grants SpaceGrant[]
  pages  Page[]
}

/// Per-space access for a user, a system role (by key) or a department.
model SpaceGrant {
  id            String             @id @default(uuid()) @db.Uuid
  spaceId       String             @db.Uuid
  space         Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  principalType SpacePrincipalType
  principalId   String
  access        SpaceAccessLevel
  createdAt     DateTime           @default(now())

  @@unique([spaceId, principalType, principalId])
}

/// A wiki page. Title/content hold the latest explicitly saved version (`version`).
model Page {
  id            String                   @id @default(uuid()) @db.Uuid
  spaceId       String                   @db.Uuid
  space         Space                    @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  parentId      String?                  @db.Uuid
  parent        Page?                    @relation("PageTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Page[]                   @relation("PageTree")
  sortOrder     Int                      @default(0)
  titleEn       String                   @default("")
  titleAr       String                   @default("")
  /// Sanitised HTML produced by the TipTap editor.
  contentEn     String                   @default("")
  contentAr     String                   @default("")
  dirEn         String                   @default("ltr")
  dirAr         String                   @default("rtl")
  /// Plain text of the content, for full-text search and snippets.
  textEn        String                   @default("")
  textAr        String                   @default("")
  version       Int                      @default(0)
  status        ProcessStatus            @default(DRAFT)
  /// Owner responsible for the content (falls back to the space owner).
  ownerId       String?                  @db.Uuid
  owner         User?                    @relation("PageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  workflowId    String?                  @db.Uuid
  workflow      Workflow?                @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  nextReviewAt  DateTime?
  /// The saved content was produced by the AI assistant and not yet edited or approved by a person.
  aiGenerated   Boolean                  @default(false)
  /// Maintained by a database trigger (see migration 20261021082019_phase2_wiki).
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  createdById   String?                  @db.Uuid
  updatedById   String?                  @db.Uuid
  deletedAt     DateTime?
  deletedById   String?                  @db.Uuid
  /// Pages deleted together (a page and its sub-pages) share a batch id and are restored together.
  deleteBatchId String?                  @db.Uuid

  versions    PageVersion[]
  drafts      PageDraft[]
  links       PageLink[]
  attachments Attachment[]

  @@index([spaceId, parentId, sortOrder])
  @@index([deleteBatchId])
  @@index([searchVector], type: Gin)
}

model PageVersion {
  id            String   @id @default(uuid()) @db.Uuid
  pageId        String   @db.Uuid
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  versionNumber Int
  titleEn       String
  titleAr       String
  contentEn     String
  contentAr     String
  dirEn         String
  dirAr         String
  changeNote    String
  label         String?
  restoredFrom  Int?
  createdAt     DateTime @default(now())
  createdById   String?  @db.Uuid

  @@unique([pageId, versionNumber])
}

/// Autosaved editor state of one user; never a version.
model PageDraft {
  pageId      String   @db.Uuid
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleEn     String
  titleAr     String
  contentEn   String
  contentAr   String
  dirEn       String
  dirAr       String
  baseVersion Int?
  updatedAt   DateTime @updatedAt

  @@id([pageId, userId])
}

model PageTemplate {
  id            String    @id @default(uuid()) @db.Uuid
  /// Set for the built-in templates (SOP, POLICY, …).
  key           String?   @unique
  nameEn        String    @default("")
  nameAr        String    @default("")
  descriptionEn String    @default("")
  descriptionAr String    @default("")
  contentEn     String    @default("")
  contentAr     String    @default("")
  isSystem      Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedAt     DateTime?
}

model PageLink {
  id           String         @id @default(uuid()) @db.Uuid
  pageId       String         @db.Uuid
  page         Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  targetType   PageLinkTarget
  processId    String?        @db.Uuid
  process      Process?       @relation(fields: [processId], references: [id], onDelete: Cascade)
  repoObjectId String?        @db.Uuid
  repoObject   RepoObject?    @relation(fields: [repoObjectId], references: [id], onDelete: Cascade)
  /// Created automatically because the page embeds the process diagram.
  embedded     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  createdById  String?        @db.Uuid

  @@unique([pageId, processId])
  @@unique([pageId, repoObjectId])
  @@index([processId])
  @@index([repoObjectId])
}

model Attachment {
  id          String    @id @default(uuid()) @db.Uuid
  pageId      String    @db.Uuid
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String
  size        Int
  storageKey  String    @unique
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([pageId])
}

// ---------- Git integration (M7) ----------

/// Sync state of one process or page in the configured Git repository.
model GitSyncItem {
  id            String        @id @default(uuid()) @db.Uuid
  entityType    GitEntityType
  entityId      String        @db.Uuid
  status        GitSyncStatus @default(PENDING)
  /// Version that was (or is being) synchronised.
  version       Int?
  /// Repository paths written by the last successful sync (to remove them after moves/renames).
  paths         String[]
  /// Set when the item should be removed from the repository (deleted in ProcessHub).
  removed       Boolean       @default(false)
  errorCode     String?
  errorMessage  String?
  commitSha     String?
  commitUrl     String?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([entityType, entityId])
  @@index([status])
}

// ---------- Governance (M8) ----------

/// Approval workflow: steps run in order; each step needs ANY or ALL of its assignees.
model Workflow {
  id            String    @id @default(uuid()) @db.Uuid
  nameEn        String    @default("")
  nameAr        String    @default("")
  descriptionEn String    @default("")
  descriptionAr String    @default("")
  /// [{ nameEn, nameAr, rule, assignees: [{ type: USER|ROLE|OWNER, userId?, roleKey?, departmentId? }] }]
  steps         Json
  autoPublish   Boolean   @default(false)
  /// False for custom workflows that belong to one process or page.
  isTemplate    Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedAt     DateTime?

  processes Process[]
  pages     Page[]
  spaces    Space[]
  diagrams  Diagram[]
}

/// One review round of one version of a process or page.
model Review {
  id                String       @id @default(uuid()) @db.Uuid
  entityType        ContentType
  entityId          String       @db.Uuid
  versionNumber     Int
  status            ReviewStatus @default(IN_PROGRESS)
  workflowId        String?      @db.Uuid
  workflowNameEn    String       @default("")
  workflowNameAr    String       @default("")
  /// Snapshot of the steps with the users resolved at submission:
  /// [{ nameEn, nameAr, rule, assigneeIds: [], approvedBySubmitter }]
  steps             Json
  autoPublish       Boolean      @default(false)
  currentStep       Int          @default(0)
  note              String       @default("")
  submittedById     String?      @db.Uuid
  submittedAt       DateTime     @default(now())
  dueAt             DateTime?
  completedAt       DateTime?
  overdueNotifiedAt DateTime?

  tasks        ReviewTask[]
  publications Publication[]

  @@index([entityType, entityId])
  @@index([status])
}

model ReviewTask {
  id         String           @id @default(uuid()) @db.Uuid
  reviewId   String           @db.Uuid
  review     Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  stepIndex  Int
  assigneeId String           @db.Uuid
  status     ReviewTaskStatus @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime         @default(now())

  @@index([assigneeId, status])
  @@index([reviewId])
}

/// A published version. Exactly one publication per item is current (partial unique index).
model Publication {
  id            String                   @id @default(uuid()) @db.Uuid
  entityType    ContentType
  entityId      String                   @db.Uuid
  versionNumber Int
  versionLabel  String?
  /// Snapshot of the published title/description (processes: name and description).
  code          String?
  titleEn       String                   @default("")
  titleAr       String                   @default("")
  descriptionEn String                   @default("")
  descriptionAr String                   @default("")
  /// Plain text for portal search (process description + step names; page text).
  textEn        String                   @default("")
  textAr        String                   @default("")
  /// Generated column (see migration 20261021120000_phase3_governance_portal).
  searchVector  Unsupported("tsvector")?
  reviewId      String?                  @db.Uuid
  review        Review?                  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  approverIds   String[]                 @db.Uuid
  publishedAt   DateTime                 @default(now())
  publishedById String?                  @db.Uuid
  current       Boolean                  @default(true)
  /// Set when a newer publication replaced this one or the item was archived.
  endedAt       DateTime?

  links PublishedLink[]

  @@index([entityType, entityId])
  @@index([current, publishedAt])
  @@index([searchVector], type: Gin)
}

/// Object links of the published BPMN version (step → role / system / document …).
model PublishedLink {
  id            String       @id @default(uuid()) @db.Uuid
  publicationId String       @db.Uuid
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  bpmnElementId String
  repoObjectId  String       @db.Uuid
  repoObject    RepoObject   @relation(fields: [repoObjectId], references: [id], onDelete: Cascade)
  relation      LinkRelation

  @@index([publicationId])
  @@index([repoObjectId])
}

model Comment {
  id            String      @id @default(uuid()) @db.Uuid
  entityType    ContentType
  entityId      String      @db.Uuid
  /// Root comment of the thread (replies are one level deep).
  parentId      String?     @db.Uuid
  parent        Comment?    @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]   @relation("CommentThread")
  bpmnElementId String?
  /// Plain text; mentions as @[Name](userId).
  body          String
  mentionIds    String[]    @db.Uuid
  createdById   String?     @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  editedAt      DateTime?
  resolvedAt    DateTime?
  resolvedById  String?     @db.Uuid
  deletedAt     DateTime?

  @@index([entityType, entityId])
  @@index([parentId])
}

model Notification {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  entityType  ContentType?
  entityId    String?      @db.Uuid
  params      Json         @default("{}")
  link        String?
  actorId     String?      @db.Uuid
  /// False when the user turned in-app notifications of this type off (email only).
  inApp       Boolean      @default(true)
  readAt      DateTime?
  emailStatus EmailStatus?
  emailError  String?
  /// Prevents duplicate reminders (e.g. "REVIEW_DUE:PROCESS:<id>:2026-11-01").
  dedupeKey   String?
  createdAt   DateTime     @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------- Knowledge Portal (M9) ----------

model Feedback {
  id          String         @id @default(uuid()) @db.Uuid
  entityType  ContentType
  entityId    String         @db.Uuid
  kind        FeedbackKind
  message     String
  status      FeedbackStatus @default(OPEN)
  reply       String?
  repliedAt   DateTime?
  repliedById String?        @db.Uuid
  /// Owner of the item when the feedback was sent.
  assigneeId  String?        @db.Uuid
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([assigneeId, status])
  @@index([createdById])
  @@index([entityType, entityId])
}

/// Job roles of a user (Roles library), used for "My processes" in the portal.
model UserJobRole {
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoObjectId String     @db.Uuid
  repoObject   RepoObject @relation(fields: [repoObjectId], references: [id], onDelete: Cascade)

  @@id([userId, repoObjectId])
  @@index([repoObjectId])
}

/// One request to the AI assistant (M16): who, which feature and model, tokens and outcome.
model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// GENERATE_PROCESS, TRANSLATE, REFINE_PROCESS, SUMMARISE, … (AI_FEATURES in packages/shared).
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// SUCCESS | ERROR | INVALID_OUTPUT
  status       String
  errorCode    String?
  durationMs   Int      @default(0)
  /// The process or page the request was about, if any.
  entityType   String?
  entityId     String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ---------- Assurance (M10, Phase 4.2) ----------

/// A proposed change of an active risk or control waiting for approval (D-098).
/// The current values stay in force until the last workflow step approves.
model GrcChange {
  id             String          @id @default(uuid()) @db.Uuid
  objectId       String          @db.Uuid
  object         RepoObject      @relation(fields: [objectId], references: [id], onDelete: Cascade)
  /// PENDING | APPROVED | REJECTED | WITHDRAWN
  status         String          @default("PENDING")
  /// The update input as sent (applied unchanged on approval).
  proposed       Json
  /// [{ field, from, to }] at submission (the visual before / after).
  fields         Json
  comment        String          @default("")
  /// Changes from one Excel import share a batch and are approved or rejected together (D-104).
  batchId        String?         @db.Uuid
  workflowId     String?         @db.Uuid
  workflowNameEn String          @default("")
  workflowNameAr String          @default("")
  /// [{ nameEn, nameAr, rule, assigneeIds }]
  steps          Json
  currentStep    Int             @default(0)
  submittedById  String?         @db.Uuid
  submittedAt    DateTime        @default(now())
  completedAt    DateTime?
  tasks          GrcChangeTask[]

  @@index([objectId, status])
  @@index([status])
  @@index([batchId])
}

model GrcChangeTask {
  id         String    @id @default(uuid()) @db.Uuid
  changeId   String    @db.Uuid
  change     GrcChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  stepIndex  Int
  assigneeId String    @db.Uuid
  /// PENDING | APPROVED | REJECTED | SKIPPED
  status     String    @default("PENDING")
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([assigneeId, status])
  @@index([changeId])
}

/// How a control is tested (Phase 4.2, D-099): procedure, type, sample size, frequency, people.
model ControlTestPlan {
  id              String        @id @default(uuid()) @db.Uuid
  controlId       String        @db.Uuid
  control         Control       @relation(fields: [controlId], references: [objectId], onDelete: Cascade)
  /// DESIGN | OPERATING
  testType        String
  /// Bilingual test steps: [{ en, ar }]
  procedure       Json          @default("[]")
  sampleSize      Int           @default(1)
  /// MONTHLY | QUARTERLY | SEMI_ANNUAL | ANNUAL | AD_HOC (default derived from the control frequency)
  frequency       String
  /// Tester / reviewer: a user, or anyone with a system role (optionally both empty: Risk & Compliance).
  testerId        String?       @db.Uuid
  testerRoleKey   String?
  reviewerId      String?       @db.Uuid
  reviewerRoleKey String?
  /// Due date of the next scheduled test; the scheduler creates it `leadDays` before.
  nextDueAt       DateTime?
  leadDays        Int           @default(30)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  deletedAt       DateTime?
  tests           ControlTest[]

  @@index([controlId])
  @@index([active, nextDueAt])
}

/// One test instance: Planned → In progress → Submitted → Reviewed (or Returned) → Closed.
model ControlTest {
  id                String           @id @default(uuid()) @db.Uuid
  planId            String?          @db.Uuid
  plan              ControlTestPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  controlId         String           @db.Uuid
  control           Control          @relation(fields: [controlId], references: [objectId], onDelete: Cascade)
  testType          String
  /// Period label, e.g. 2026-Q4 (scheduled) or the due date (manual).
  period            String
  dueAt             DateTime
  /// PLANNED | IN_PROGRESS | SUBMITTED | RETURNED | REVIEWED | CLOSED
  status            String           @default("PLANNED")
  /// SCHEDULED | MANUAL
  origin            String           @default("MANUAL")
  procedure         Json             @default("[]")
  sampleSize        Int              @default(1)
  testerId          String?          @db.Uuid
  testerRoleKey     String?
  reviewerId        String?          @db.Uuid
  reviewerRoleKey   String?
  /// [{ ref, steps: (PASS|FAIL|NA|null)[], result: PASS|EXCEPTION|FAIL|null, note }]
  samples           Json             @default("[]")
  /// EFFECTIVE | EFFECTIVE_WITH_EXCEPTIONS | NOT_EFFECTIVE
  conclusion        String?
  testerComment     String           @default("")
  reviewComment     String           @default("")
  executedById      String?          @db.Uuid
  reviewedById      String?          @db.Uuid
  startedAt         DateTime?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  closedAt          DateTime?
  /// Reminder bookkeeping (due soon / overdue sent for this due date).
  dueNotifiedAt     DateTime?
  overdueNotifiedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?          @db.Uuid
  deletedAt         DateTime?

  @@index([controlId])
  @@index([planId, dueAt])
  @@index([status, dueAt])
  @@index([testerId])
  @@index([reviewerId])
}

/// Evidence and other files of assurance records (tests, issues, actions, audit items, answers).
model AssuranceFile {
  id          String    @id @default(uuid()) @db.Uuid
  /// CONTROL_TEST | ISSUE | ISSUE_ACTION | AUDIT_ITEM | AUDIT_FINDING | SURVEY_RESPONSE
  ownerType   String
  ownerId     String    @db.Uuid
  fileName    String
  contentType String
  size        Int
  storageKey  String    @unique
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([ownerType, ownerId])
}

/// History and comments of assurance records (tests, issues, engagements …).
model AssuranceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  /// CREATED | STATUS | UPDATED | COMMENT | FILE
  kind        String
  changes     Json     @default("{}")
  comment     String   @default("")
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  createdBy   User?    @relation("AssuranceEventAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

/// An issue to fix (Phase 4.2, D-100): from a failed test, a risk assessment, an audit finding,
/// portal feedback or raised by hand. Open → In progress → Ready for verification → Closed, or
/// Accepted risk (justification + approver).
model Issue {
  id                      String        @id @default(uuid()) @db.Uuid
  /// ISS-0001 …
  code                    String        @unique
  titleEn                 String        @default("")
  titleAr                 String        @default("")
  descriptionEn           String        @default("")
  descriptionAr           String        @default("")
  /// CONTROL_TEST | RISK_ASSESSMENT | AUDIT_FINDING | FEEDBACK | MANUAL
  sourceType              String        @default("MANUAL")
  sourceId                String?       @db.Uuid
  /// Key of the configurable severity scale (Setting `assurance`).
  severity                String
  /// OPEN | IN_PROGRESS | READY_FOR_VERIFICATION | CLOSED | ACCEPTED_RISK
  status                  String        @default("OPEN")
  ownerId                 String?       @db.Uuid
  dueAt                   DateTime?
  processId               String?       @db.Uuid
  bpmnElementId           String?
  riskId                  String?       @db.Uuid
  controlId               String?       @db.Uuid
  requirementId           String?       @db.Uuid
  departmentId            String?       @db.Uuid
  acceptanceJustification String        @default("")
  acceptedById            String?       @db.Uuid
  acceptedAt              DateTime?
  verifiedById            String?       @db.Uuid
  verifiedAt              DateTime?
  closedAt                DateTime?
  dueNotifiedAt           DateTime?
  overdueNotifiedAt       DateTime?
  escalatedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  /// The raiser (verifies the fix together with Risk & Compliance).
  createdById             String?       @db.Uuid
  updatedById             String?       @db.Uuid
  deletedAt               DateTime?
  actions                 IssueAction[]

  @@index([status])
  @@index([ownerId])
  @@index([sourceType, sourceId])
  @@index([processId])
  @@index([controlId])
  @@index([riskId])
}

/// An action of an issue's action plan: owner, due date, progress and evidence.
model IssueAction {
  id                String    @id @default(uuid()) @db.Uuid
  issueId           String    @db.Uuid
  issue             Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  titleEn           String    @default("")
  titleAr           String    @default("")
  note              String    @default("")
  ownerId           String?   @db.Uuid
  dueAt             DateTime?
  /// 0–100; 100 = done.
  progress          Int       @default(0)
  completedAt       DateTime?
  sortOrder         Int       @default(0)
  dueNotifiedAt     DateTime?
  overdueNotifiedAt DateTime?
  escalatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?   @db.Uuid
  updatedById       String?   @db.Uuid
  deletedAt         DateTime?

  @@index([issueId])
  @@index([ownerId])
}

/// An audit engagement of the annual audit plan (Phase 4.2, D-101):
/// Planned → Fieldwork → Reporting → Follow-up → Closed.
model AuditEngagement {
  id             String          @id @default(uuid()) @db.Uuid
  /// AUD-2026-01 …
  code           String          @unique
  year           Int
  titleEn        String          @default("")
  titleAr        String          @default("")
  objectiveEn    String          @default("")
  objectiveAr    String          @default("")
  scopeEn        String          @default("")
  scopeAr        String          @default("")
  /// PLANNED | FIELDWORK | REPORTING | FOLLOW_UP | CLOSED
  status         String          @default("PLANNED")
  leadId         String?         @db.Uuid
  teamIds        String[]        @db.Uuid
  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  /// Scope: processes, departments, risks, controls, requirements.
  processIds     String[]        @db.Uuid
  departmentIds  String[]        @db.Uuid
  riskIds        String[]        @db.Uuid
  controlIds     String[]        @db.Uuid
  requirementIds String[]        @db.Uuid
  /// Executive summary of the report.
  summaryEn      String          @default("")
  summaryAr      String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?         @db.Uuid
  updatedById    String?         @db.Uuid
  deletedAt      DateTime?
  items          AuditWorkItem[]
  findings       AuditFinding[]

  @@index([year, status])
}

/// A checklist item / test step of the work programme, optionally for a control.
model AuditWorkItem {
  id           String          @id @default(uuid()) @db.Uuid
  engagementId String          @db.Uuid
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  sortOrder    Int             @default(0)
  titleEn      String          @default("")
  titleAr      String          @default("")
  /// Test steps [{ en, ar }] (copied from the control's test procedure when chosen).
  procedure    Json            @default("[]")
  controlId    String?         @db.Uuid
  /// OPEN | DONE | NOT_APPLICABLE
  status       String          @default("OPEN")
  /// SATISFACTORY | EXCEPTION
  result       String?
  /// Working notes.
  notes        String          @default("")
  assigneeId   String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String?         @db.Uuid
  deletedAt    DateTime?

  @@index([engagementId])
}

/// An audit finding with the management response; an agreed finding creates an issue.
model AuditFinding {
  id               String          @id @default(uuid()) @db.Uuid
  engagementId     String          @db.Uuid
  engagement       AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  /// F-01 … within the engagement.
  code             String
  titleEn          String          @default("")
  titleAr          String          @default("")
  /// Key of the severity scale (Setting `assurance`).
  rating           String
  conditionEn      String          @default("")
  conditionAr      String          @default("")
  criteriaEn       String          @default("")
  criteriaAr       String          @default("")
  requirementId    String?         @db.Uuid
  causeEn          String          @default("")
  causeAr          String          @default("")
  effectEn         String          @default("")
  effectAr         String          @default("")
  recommendationEn String          @default("")
  recommendationAr String          @default("")
  processId        String?         @db.Uuid
  bpmnElementId    String?
  riskId           String?         @db.Uuid
  controlId        String?         @db.Uuid
  workItemId       String?         @db.Uuid
  /// PENDING | ACCEPTED | DISAGREED
  responseStatus   String          @default("PENDING")
  responseOwnerId  String?         @db.Uuid
  agreedActionEn   String          @default("")
  agreedActionAr   String          @default("")
  targetDate       DateTime?
  responseComment  String          @default("")
  respondedAt      DateTime?
  respondedById    String?         @db.Uuid
  /// The issue created when management agreed.
  issueId          String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String?         @db.Uuid
  updatedById      String?         @db.Uuid
  deletedAt        DateTime?

  @@unique([engagementId, code])
  @@index([responseOwnerId])
}

/// A reusable questionnaire (Phase 4.2, D-102): sections of typed questions, bilingual.
model Questionnaire {
  id            String           @id @default(uuid()) @db.Uuid
  titleEn       String           @default("")
  titleAr       String           @default("")
  descriptionEn String           @default("")
  descriptionAr String           @default("")
  /// GENERAL | RCSA | COMPLIANCE | PROCESS_FEEDBACK
  purpose       String           @default("GENERAL")
  /// { sections: [{ id, titleEn, titleAr, questions: [...] }] }
  definition    Json
  /// DRAFT | ACTIVE | ARCHIVED
  status        String           @default("DRAFT")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String?          @db.Uuid
  updatedById   String?          @db.Uuid
  deletedAt     DateTime?
  campaigns     SurveyCampaign[]
}

/// A questionnaire sent to users, roles or departments for a period.
model SurveyCampaign {
  id                 String           @id @default(uuid()) @db.Uuid
  questionnaireId    String?          @db.Uuid
  questionnaire      Questionnaire?   @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  titleEn            String           @default("")
  titleAr            String           @default("")
  purpose            String           @default("GENERAL")
  /// Message to the recipients (default: the questionnaire description).
  descriptionEn      String           @default("")
  descriptionAr      String           @default("")
  /// Snapshot of the questionnaire when the campaign was created.
  definition         Json
  /// DRAFT | OPEN | CLOSED
  status             String           @default("DRAFT")
  /// { userIds, roleKeys, departmentIds }
  audience           Json             @default("{}")
  startAt            DateTime?
  endAt              DateTime?
  reminderDaysBefore Int              @default(3)
  /// Feedback on a (draft) process / compliance self-assessment of a department.
  processId          String?          @db.Uuid
  departmentId       String?          @db.Uuid
  launchedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdById        String?          @db.Uuid
  updatedById        String?          @db.Uuid
  deletedAt          DateTime?
  responses          SurveyResponse[]
  proposals          SurveyProposal[]

  @@index([status, endAt])
  @@index([processId])
}

/// One recipient's answers: Sent → Opened → Submitted.
model SurveyResponse {
  id             String         @id @default(uuid()) @db.Uuid
  campaignId     String         @db.Uuid
  campaign       SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String         @db.Uuid
  /// SENT | OPENED | SUBMITTED
  status         String         @default("SENT")
  /// { questionId: value }
  answers        Json           @default("{}")
  score          Float?
  maxScore       Float?
  openedAt       DateTime?
  submittedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([campaignId, userId])
  @@index([userId, status])
}

/// A rating / effectiveness proposed by a self-assessment answer, for a Risk & Compliance officer.
model SurveyProposal {
  id          String         @id @default(uuid()) @db.Uuid
  campaignId  String         @db.Uuid
  campaign    SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  responseId  String         @db.Uuid
  questionId  String
  objectId    String         @db.Uuid
  /// LIKELIHOOD | IMPACT | EFFECTIVENESS
  field       String
  value       String
  /// PENDING | ACCEPTED | DISMISSED
  status      String         @default("PENDING")
  decidedById String?        @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([campaignId, status])
  @@index([objectId])
}

// ---------- Enterprise architecture (M11, Phase 4.3 — D-107) ----------

enum AppType {
  APPLICATION
  PLATFORM
  SERVICE
  DATABASE
  EXTERNAL
}

enum AppHosting {
  ON_PREMISE
  CLOUD
  SAAS
}

enum AppLifecycle {
  PLANNED
  ACTIVE
  PHASING_OUT
  RETIRED
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
}

enum InterfaceDirection {
  ONE_WAY
  TWO_WAY
}

enum InterfaceTechnology {
  API
  FILE
  DB_LINK
  MANUAL
  MESSAGE_QUEUE
}

enum InterfaceFrequency {
  REAL_TIME
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  ON_DEMAND
}

enum EaStatus {
  PLANNED
  ACTIVE
  RETIRED
}

enum StrategicImportance {
  LOW
  MEDIUM
  HIGH
}

/// Application catalogue entry; code, bilingual name and description live on the RepoObject (type SYSTEM),
/// so step links, badges and "where used" of the former IT system objects keep working (D-107).
model Application {
  objectId           String             @id @db.Uuid
  object             RepoObject         @relation(fields: [objectId], references: [id], onDelete: Cascade)
  appType            AppType            @default(APPLICATION)
  vendor             String             @default("")
  version            String             @default("")
  businessOwnerId    String?            @db.Uuid
  businessOwner      User?              @relation("AppBusinessOwner", fields: [businessOwnerId], references: [id], onDelete: SetNull)
  itOwnerId          String?            @db.Uuid
  itOwner            User?              @relation("AppItOwner", fields: [itOwnerId], references: [id], onDelete: SetNull)
  departmentId       String?            @db.Uuid
  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hosting            AppHosting         @default(ON_PREMISE)
  /// ISO 3166-1 alpha-2 country of the hosting (data residency).
  hostingCountry     String             @default("")
  lifecycle          AppLifecycle       @default(ACTIVE)
  /// Lifecycle dates: go-live, start of phase-out, retirement.
  liveFrom           DateTime?
  phaseOutFrom       DateTime?
  retiredAt          DateTime?
  criticality        Criticality        @default(MEDIUM)
  dataClassification DataClassification @default(INTERNAL)
  licenceNotes       String             @default("")
  url                String?

  outgoing     AppInterface[]          @relation("InterfaceSource")
  incoming     AppInterface[]          @relation("InterfaceTarget")
  dataUsages   DataObjectUsage[]
  recordOf     DataObject[]            @relation("SystemOfRecord")
  capabilities CapabilityApplication[]

  @@index([lifecycle])
  @@index([departmentId])
}

/// Data flow between two applications.
model AppInterface {
  id            String              @id @default(uuid()) @db.Uuid
  code          String?
  nameEn        String              @default("")
  nameAr        String              @default("")
  descriptionEn String              @default("")
  descriptionAr String              @default("")
  sourceId      String              @db.Uuid
  source        Application         @relation("InterfaceSource", fields: [sourceId], references: [objectId], onDelete: Cascade)
  targetId      String              @db.Uuid
  target        Application         @relation("InterfaceTarget", fields: [targetId], references: [objectId], onDelete: Cascade)
  direction     InterfaceDirection  @default(ONE_WAY)
  technology    InterfaceTechnology @default(API)
  frequency     InterfaceFrequency  @default(DAILY)
  ownerId       String?             @db.Uuid
  owner         User?               @relation("InterfaceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status        EaStatus            @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdById   String?             @db.Uuid
  updatedById   String?             @db.Uuid
  deletedAt     DateTime?

  dataObjects InterfaceDataObject[]

  @@index([sourceId])
  @@index([targetId])
}

/// Business entity (Budget, Invoice, Employee …) with its system of record.
model DataObject {
  id               String             @id @default(uuid()) @db.Uuid
  code             String?
  nameEn           String             @default("")
  nameAr           String             @default("")
  definitionEn     String             @default("")
  definitionAr     String             @default("")
  classification   DataClassification @default(INTERNAL)
  systemOfRecordId String?            @db.Uuid
  systemOfRecord   Application?       @relation("SystemOfRecord", fields: [systemOfRecordId], references: [objectId], onDelete: SetNull)
  ownerId          String?            @db.Uuid
  owner            User?              @relation("DataObjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdById      String?            @db.Uuid
  updatedById      String?            @db.Uuid
  deletedAt        DateTime?

  usages     DataObjectUsage[]
  interfaces InterfaceDataObject[]
}

/// CRUD matrix: what an application does with a data object.
model DataObjectUsage {
  dataObjectId  String      @db.Uuid
  dataObject    DataObject  @relation(fields: [dataObjectId], references: [id], onDelete: Cascade)
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [objectId], onDelete: Cascade)
  canCreate     Boolean     @default(false)
  canRead       Boolean     @default(false)
  canUpdate     Boolean     @default(false)
  canDelete     Boolean     @default(false)

  @@id([dataObjectId, applicationId])
  @@index([applicationId])
}

/// Data objects carried by an interface.
model InterfaceDataObject {
  interfaceId  String       @db.Uuid
  interface    AppInterface @relation(fields: [interfaceId], references: [id], onDelete: Cascade)
  dataObjectId String       @db.Uuid
  dataObject   DataObject   @relation(fields: [dataObjectId], references: [id], onDelete: Cascade)

  @@id([interfaceId, dataObjectId])
  @@index([dataObjectId])
}

/// Business capability map (levels 1–3).
model Capability {
  id            String              @id @default(uuid()) @db.Uuid
  code          String?
  nameEn        String              @default("")
  nameAr        String              @default("")
  descriptionEn String              @default("")
  descriptionAr String              @default("")
  parentId      String?             @db.Uuid
  parent        Capability?         @relation("CapabilityTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Capability[]        @relation("CapabilityTree")
  level         Int                 @default(1)
  sortOrder     Int                 @default(0)
  ownerId       String?             @db.Uuid
  owner         User?               @relation("CapabilityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  importance    StrategicImportance @default(MEDIUM)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdById   String?             @db.Uuid
  updatedById   String?             @db.Uuid
  deletedAt     DateTime?

  processes    CapabilityProcess[]
  applications CapabilityApplication[]
  kpis         KpiCapability[]

  @@index([parentId, sortOrder])
}

model CapabilityProcess {
  capabilityId String     @db.Uuid
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  processId    String     @db.Uuid
  process      Process    @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([capabilityId, processId])
  @@index([processId])
}

model CapabilityApplication {
  capabilityId  String      @db.Uuid
  capability    Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [objectId], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([capabilityId, applicationId])
  @@index([applicationId])
}

// ---------- KPIs (M12, Phase 4.3 — D-111) ----------

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum KpiFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum KpiDataSource {
  MANUAL
  EXCEL
  SALESFORCE
  CALCULATED
  EVENT_LOG
}

enum KpiStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// KPI definition; code, bilingual name, definition (description) and owner live on the RepoObject (type KPI),
/// so links to processes and steps (relation MEASURES) keep working (D-111).
model Kpi {
  objectId            String        @id @db.Uuid
  object              RepoObject    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  formulaEn           String        @default("")
  formulaAr           String        @default("")
  unit                String        @default("")
  direction           KpiDirection  @default(HIGHER_IS_BETTER)
  frequency           KpiFrequency  @default(MONTHLY)
  target              Float?
  /// Green from this value (default: the target); red from `redThreshold`; amber between.
  greenThreshold      Float?
  redThreshold        Float?
  baseline            Float?
  baselinePeriod      String?
  departmentId        String?       @db.Uuid
  department          Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  dataSource          KpiDataSource @default(MANUAL)
  status              KpiStatus     @default(ACTIVE)
  calculatedMetric    String?
  calculatedProcessId String?       @db.Uuid
  calculatedProcess   Process?      @relation("KpiCalculatedProcess", fields: [calculatedProcessId], references: [id], onDelete: SetNull)
  /// Process mining (Phase 5.1, D-136): event log of an EVENT_LOG KPI.
  miningLogId         String?       @db.Uuid
  miningLog           EventLog?     @relation(fields: [miningLogId], references: [id], onDelete: SetNull)
  /// Salesforce (step 5): record id of the measure, record URL, last sync, fields owned by Salesforce.
  salesforceId        String?       @unique
  salesforceUrl       String?
  lastSyncedAt        DateTime?
  lockedFields        String[]      @default([])
  /// Last period for which the owner was reminded (one reminder per period).
  reminderSentFor     String?

  periodTargets KpiPeriodTarget[]
  measurements  KpiMeasurement[]
  objectives    KpiObjective[]
  capabilities  KpiCapability[]
  risks         KpiRisk[]

  @@index([status])
  @@index([departmentId])
}

/// Target and thresholds of one period (override the KPI's own values).
model KpiPeriodTarget {
  kpiId          String @db.Uuid
  kpi            Kpi    @relation(fields: [kpiId], references: [objectId], onDelete: Cascade)
  period         String
  target         Float?
  greenThreshold Float?
  redThreshold   Float?

  @@id([kpiId, period])
}

/// Actual value of a KPI for one period ("2026-03", "2026-Q1", "2026").
model KpiMeasurement {
  id           String        @id @default(uuid()) @db.Uuid
  kpiId        String        @db.Uuid
  kpi          Kpi           @relation(fields: [kpiId], references: [objectId], onDelete: Cascade)
  period       String
  periodStart  DateTime
  value        Float
  comment      String        @default("")
  source       KpiDataSource @default(MANUAL)
  salesforceId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?       @db.Uuid
  updatedById  String?       @db.Uuid

  @@unique([kpiId, period])
  @@index([kpiId, periodStart])
}

/// Strategic objectives (a simple bilingual hierarchy).
model StrategicObjective {
  id            String               @id @default(uuid()) @db.Uuid
  code          String?
  nameEn        String               @default("")
  nameAr        String               @default("")
  descriptionEn String               @default("")
  descriptionAr String               @default("")
  parentId      String?              @db.Uuid
  parent        StrategicObjective?  @relation("ObjectiveTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      StrategicObjective[] @relation("ObjectiveTree")
  ownerId       String?              @db.Uuid
  owner         User?                @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sortOrder     Int                  @default(0)
  salesforceId  String?              @unique
  lastSyncedAt  DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  createdById   String?              @db.Uuid
  updatedById   String?              @db.Uuid
  deletedAt     DateTime?

  kpis KpiObjective[]

  @@index([parentId, sortOrder])
}

model KpiObjective {
  kpiId       String             @db.Uuid
  kpi         Kpi                @relation(fields: [kpiId], references: [objectId], onDelete: Cascade)
  objectiveId String             @db.Uuid
  objective   StrategicObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@id([kpiId, objectiveId])
  @@index([objectiveId])
}

model KpiCapability {
  kpiId        String     @db.Uuid
  kpi          Kpi        @relation(fields: [kpiId], references: [objectId], onDelete: Cascade)
  capabilityId String     @db.Uuid
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([kpiId, capabilityId])
  @@index([capabilityId])
}

/// Key risk indicator: the KPI signals the risk.
model KpiRisk {
  kpiId  String @db.Uuid
  kpi    Kpi    @relation(fields: [kpiId], references: [objectId], onDelete: Cascade)
  riskId String @db.Uuid
  risk   Risk   @relation(fields: [riskId], references: [objectId], onDelete: Cascade)

  @@id([kpiId, riskId])
  @@index([riskId])
}

/// Salesforce KPI sync runs (Phase 4.3, D-116): counts, warnings and the error of each run.
model SalesforceSyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  /// MANUAL | SCHEDULED
  trigger        String
  /// RUNNING | SUCCESS | FAILED
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  counts         Json      @default("{}")
  warnings       Json      @default("[]")
  error          String?
  /// Who started a manual run; null for scheduled runs (system actor "Salesforce sync", D-119).
  userId         String?   @db.Uuid
  /// The Super Admin who configured the link (saved the settings last) at the time of the run.
  configuredById String?   @db.Uuid

  @@index([startedAt])
}

// ---------- Diagram types (value chain, organisation chart, DMN, EPC, SIPOC — D-120) ----------

enum DiagramType {
  VALUE_CHAIN
  ORG_CHART
  DMN
  EPC
  SIPOC
}

/// A non-BPMN diagram. Content: DMN 1.3 XML for DMN, versioned JSON (packages/shared diagrams.ts) otherwise.
model Diagram {
  id                 String        @id @default(uuid()) @db.Uuid
  type               DiagramType
  code               String
  nameEn             String        @default("")
  nameAr             String        @default("")
  descriptionEn      String        @default("")
  descriptionAr      String        @default("")
  status             ProcessStatus @default(DRAFT)
  /// Parent process / process-house node (optional).
  processId          String?       @db.Uuid
  process            Process?      @relation(fields: [processId], references: [id], onDelete: SetNull)
  ownerId            String?       @db.Uuid
  owner              User?         @relation("DiagramOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  departmentId       String?       @db.Uuid
  department         Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sortOrder          Int           @default(0)
  workflowId         String?       @db.Uuid
  workflow           Workflow?     @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  nextReviewAt       DateTime?
  aiGenerated        Boolean       @default(false)
  /// Working content (autosaved draft); versions are explicit snapshots.
  content            String
  contentUpdatedAt   DateTime      @default(now())
  contentUpdatedById String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdById        String?       @db.Uuid
  updatedById        String?       @db.Uuid
  deletedAt          DateTime?

  versions DiagramVersion[]
  links    DiagramLink[]

  @@index([type])
  @@index([processId])
  @@index([code])
}

model DiagramVersion {
  id            String   @id @default(uuid()) @db.Uuid
  diagramId     String   @db.Uuid
  diagram       Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String
  changeNote    String
  label         String?
  restoredFrom  Int?
  createdAt     DateTime @default(now())
  createdById   String?  @db.Uuid

  @@unique([diagramId, versionNumber])
}

/// Diagram element ↔ library object (role, IT system, term, risk, control, KPI …), like ObjectLink for BPMN.
model DiagramLink {
  id           String       @id @default(uuid()) @db.Uuid
  diagramId    String       @db.Uuid
  diagram      Diagram      @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  elementId    String
  repoObjectId String       @db.Uuid
  repoObject   RepoObject   @relation(fields: [repoObjectId], references: [id], onDelete: Cascade)
  relation     LinkRelation
  createdAt    DateTime     @default(now())
  createdById  String?      @db.Uuid

  @@unique([diagramId, elementId, repoObjectId, relation])
  @@index([repoObjectId])
}

// ---------- Process mining (Phase 5.1, M13 — D-128 – ) ----------

enum EventLogSource {
  FILE
  PROCESSHUB
}

enum EventLogStatus {
  DRAFT
  IMPORTING
  READY
  FAILED
  DELETING
}

enum MiningJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

/// An event log: uploaded file (CSV / Excel / XES) or built from ProcessHub data, with its import mapping.
/// Visible to the owner, members of its department and granted users only (D-131). Deleted for good (events too).
model EventLog {
  id             String         @id @default(uuid()) @db.Uuid
  code           String
  nameEn         String         @default("")
  nameAr         String         @default("")
  descriptionEn  String         @default("")
  descriptionAr  String         @default("")
  source         EventLogSource @default(FILE)
  status         EventLogStatus @default(DRAFT)
  processId      String?        @db.Uuid
  process        Process?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  ownerId        String?        @db.Uuid
  owner          User?          @relation("EventLogOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  departmentId   String?        @db.Uuid
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Uploaded file in the S3-compatible storage (kept for re-imports with another mapping).
  fileKey        String?
  fileName       String?
  fileFormat     String?
  fileSize       Int?
  mapping        Json?
  timeZone       String         @default("Asia/Dubai")
  pseudonymised  Boolean        @default(false)
  /// Incremented by every import: the columnar snapshot and cached results belong to one version.
  dataVersion    Int            @default(0)
  snapshotKey    String?
  periodStart    DateTime?
  periodEnd      DateTime?
  caseCount      Int            @default(0)
  eventCount     Int            @default(0)
  activityCount  Int            @default(0)
  resourceCount  Int            @default(0)
  hasStartTimes  Boolean        @default(false)
  attributeNames String[]       @default([])
  importReport   Json?
  importedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?        @db.Uuid
  updatedById    String?        @db.Uuid

  grants     EventLogGrant[]
  activities MiningActivity[]
  jobs       MiningJob[]
  caches     MiningResultCache[]
  presets    MiningFilterPreset[]
  kpis       Kpi[]

  @@index([processId])
  @@index([ownerId])
  @@index([departmentId])
}

model EventLogGrant {
  logId       String   @db.Uuid
  log         EventLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  user        User     @relation("EventLogGrants", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  @@id([logId, userId])
  @@index([userId])
}

/// One event (activity instance). No foreign key to EventLog: deleting a log removes its events in batches (a job).
model MiningEvent {
  id         BigInt    @id @default(autoincrement())
  logId      String    @db.Uuid
  caseId     String
  activity   String
  startAt    DateTime?
  endAt      DateTime
  resource   String?
  department String?
  attributes Json?

  @@index([logId, caseId, endAt])
  @@index([logId, activity])
}

/// Distinct activity of a log with its counts and the BPMN step it is mapped to (D-130).
model MiningActivity {
  logId         String   @db.Uuid
  log           EventLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  name          String
  eventCount    Int      @default(0)
  caseCount     Int      @default(0)
  bpmnElementId String?
  /// LABEL | SYNONYM | MANUAL
  match         String?

  @@id([logId, name])
}

/// Background work (import, analysis, discovery, conformance, KPI calculation, simulation) — D-128.
model MiningJob {
  id              String          @id @default(uuid()) @db.Uuid
  kind            String
  status          MiningJobStatus @default(QUEUED)
  progress        Float           @default(0)
  message         String          @default("")
  logId           String?         @db.Uuid
  log             EventLog?       @relation(fields: [logId], references: [id], onDelete: Cascade)
  scenarioId      String?         @db.Uuid
  params          Json?
  result          Json?
  error           String?
  cancelRequested Boolean         @default(false)
  createdById     String?         @db.Uuid
  createdAt       DateTime        @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([status, createdAt])
  @@index([logId])
  @@index([scenarioId])
}

/// Cached analysis result per log data version and request hash.
model MiningResultCache {
  key         String   @id
  logId       String   @db.Uuid
  log         EventLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  dataVersion Int
  kind        String
  result      Json
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([logId])
}

/// Reusable column mapping for imports.
model MiningMappingTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  format    String
  mapping   Json
  ownerId   String?  @db.Uuid
  owner     User?    @relation("MiningTemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// Saved filter stack of one user (per log or for any log).
model MiningFilterPreset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation("MiningPresetUser", fields: [userId], references: [id], onDelete: Cascade)
  logId     String?   @db.Uuid
  log       EventLog? @relation(fields: [logId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime  @default(now())

  @@index([userId, logId])
}
