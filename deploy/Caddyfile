# ProcessHub reverse proxy (production, docker-compose.prod.yml).
# Caddy obtains and renews the HTTPS certificate automatically and redirects http:// to https://.
# DOMAIN and CADDY_TLS come from .env (see .env.example.prod and docs/DEPLOYMENT.md).
{
	# The admin API only listens inside the container (used by the health check).
	admin 127.0.0.1:2019
}

{$DOMAIN} {
	# CADDY_TLS: your e-mail address (Let's Encrypt, public domain), "internal" (Caddy's own certificate
	# authority, for intranet names) or "/certs/cert.pem /certs/key.pem" (your company's certificate files,
	# placed in deploy/certs/).
	tls {$CADDY_TLS}

	header {
		# Browsers only use HTTPS for this host for one year (add "; includeSubDomains" only if every
		# sub-domain also serves HTTPS).
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Uploads: attachments are at most 10 MB, event log files (process mining) MINING_UPLOAD_MAX_MB
	# (default 200 MB); the API enforces the exact limits per route.
	@miningUpload path /api/v1/mining/logs/upload
	request_body @miningUpload {
		max_size 210MB
	}
	@otherUploads not path /api/v1/mining/logs/upload
	request_body @otherUploads {
		max_size 12MB
	}

	# Compression of responses that are not compressed yet (API JSON, HTML); the app's JavaScript
	# and CSS arrive precompressed (Brotli / gzip) from the web container and pass through as they
	# are. zstd for current browsers, gzip for the rest.
	encode zstd gzip

	# Everything goes to the web container (nginx serves the app and forwards /api to the API).
	# Server-Sent Events (AI assistant) are streamed without buffering automatically.
	reverse_proxy web:8080

	# Access log without secrets (final session part B, SEC-39): Caddy already hides Cookie,
	# Set-Cookie and Authorization; the public API key, the CSRF token and the one-time tokens of
	# invitation and unsubscribe links are removed as well.
	log {
		output stdout
		format filter {
			wrap json
			request>headers>X-Api-Key delete
			request>headers>X-Csrf-Token delete
			request>uri regexp "(/(?:invitations?|unsubscribe)/)[^/?#]+" "${1}REDACTED"
		}
	}
}
