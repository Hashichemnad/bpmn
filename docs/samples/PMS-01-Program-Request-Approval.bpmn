<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ph="http://processhub.io/schema/bpmn" id="Definitions_PMS01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_PMS01">
    <bpmn:participant id="Participant_PMS01" name="Program / Initiative Request &amp; Approval" ph:nameEn="Program / Initiative Request &amp; Approval" ph:nameAr="طلب البرنامج / المبادرة واعتماده" processRef="Process_PMS01" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PMS01" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PMS01">
      <bpmn:lane id="Lane_Requester" name="Requester (Employee)" ph:nameEn="Requester (Employee)" ph:nameAr="مقدم الطلب (الموظف)">
        <bpmn:flowNodeRef>Start_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screening</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CostFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadCost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadScope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Administration Department" ph:nameEn="Administration Department" ph:nameAr="إدارة الشؤون الإدارية">
        <bpmn:flowNodeRef>Task_Quotations</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SectionMgr" name="Section Manager" ph:nameEn="Section Manager" ph:nameAr="رئيس القسم">
        <bpmn:flowNodeRef>Task_SMReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected_SM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DeptDir" name="Department Director" ph:nameEn="Department Director" ph:nameAr="مدير الإدارة">
        <bpmn:flowNodeRef>Task_DDReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected_DD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PMO" name="PM Office (Strategy Office)" ph:nameEn="PM Office (Strategy Office)" ph:nameAr="مكتب الاستراتيجية وإدارة المشاريع">
        <bpmn:flowNodeRef>Task_PMOReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PMO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected_PMO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DGO" name="DG Office" ph:nameEn="DG Office" ph:nameAr="مكتب المدير العام">
        <bpmn:flowNodeRef>Task_DGOReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Budget" name="Budget Section" ph:nameEn="Budget Section" ph:nameAr="قسم الموازنة">
        <bpmn:flowNodeRef>Task_BudgetReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BudgetDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected_BudgetDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="PMS (Salesforce)" ph:nameEn="PMS (Salesforce)" ph:nameAr="نظام إدارة المحافظ (Salesforce)">
        <bpmn:flowNodeRef>Service_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_CreateProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_NotifyRequester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Created</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Need" name="Need for a new program identified" ph:nameEn="Need for a new program identified" ph:nameAr="تحديد الحاجة إلى برنامج جديد" ph:descriptionEn="An idea, benchmark, report, global practice, questionnaire, meeting output or leadership guidance suggests a new program." ph:descriptionAr="تنشأ فكرة برنامج جديد من مقترح أو مقارنة معيارية أو تقرير أو ممارسة عالمية أو استبيان أو مخرجات اجتماع أو توجيه قيادي.">
      <bpmn:outgoing>Flow_1_PMS01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreateRequest" name="Create program request (draft)" ph:nameEn="Create program request (draft)" ph:nameAr="إنشاء طلب البرنامج (مسودة)" ph:descriptionEn="In Program Requests &gt; New: program name, description, justifications, strategic objective, program type (digital / non-digital), source of suggestion, nature (new / continuation), delivery options with advantages and disadvantages, link to internal operations or services, and the four 1–5 priority criteria." ph:descriptionAr="من طلبات البرامج &gt; جديد: اسم البرنامج، الوصف، المبررات، الهدف الاستراتيجي، نوع البرنامج (رقمي / غير رقمي)، مصدر الاقتراح، طبيعة البرنامج (جديد / استمرار)، خيارات التنفيذ مع المزايا والعيوب، الربط بالعمليات أو الخدمات الداخلية، ومعايير الأولوية الأربعة (1–5).">
      <bpmn:incoming>Flow_1_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_2_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Screening" name="Answer screening questions" ph:nameEn="Answer screening questions" ph:nameAr="الإجابة على أسئلة الفرز" ph:descriptionEn="Core to the unit? One-off without repetition? Specific time period? Unique outputs? Requires at least the threshold budget? Operational costs?" ph:descriptionAr="هل العمل جوهري للوحدة؟ هل يُنفذ مرة واحدة دون تكرار؟ هل له فترة زمنية محددة؟ هل له مخرجات فريدة؟ هل يتطلب ميزانية لا تقل عن الحد المعتمد؟ هل توجد تكاليف تشغيلية؟">
      <bpmn:incoming>Flow_2_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_3_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Service_Classify" name="Classify as Project or Initiative and score priority" ph:nameEn="Classify as Project or Initiative and score priority" ph:nameAr="التصنيف إلى مشروع أو مبادرة واحتساب الأولوية" ph:descriptionEn="Project when all screening answers are Yes and the approximate budget is at least AED 50,000 (threshold maintained by PM Office); otherwise Initiative. Evaluation Score and priority band are calculated from the four criteria." ph:descriptionAr="يُصنف الطلب مشروعًا إذا كانت جميع إجابات الفرز نعم والميزانية التقريبية 50,000 درهم أو أكثر (حد يحدده مكتب إدارة المشاريع)، وإلا يُصنف مبادرة. تُحتسب درجة التقييم وفئة الأولوية من المعايير الأربعة.">
      <bpmn:incoming>Flow_3_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_4_PMS01</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_CostFile" name="Cost estimation available?" ph:nameEn="Cost estimation available?" ph:nameAr="هل يتوفر تقدير للتكلفة؟">
      <bpmn:incoming>Flow_4_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_5_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_6_PMS01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UploadCost" name="Upload cost estimation file" ph:nameEn="Upload cost estimation file" ph:nameAr="رفع ملف تقدير التكلفة" ph:descriptionEn="Cost Estimation File action: upload the available quotation and enter the estimated budget with Year 1–4 costs (must equal the estimated budget) and expected start and end dates (within 3 years)." ph:descriptionAr="من إجراء ملف تقدير التكلفة: رفع عرض السعر المتوفر وإدخال الميزانية التقديرية مع تكاليف السنوات 1–4 (يجب أن يساوي مجموعها الميزانية) وتاريخي البدء والانتهاء المتوقعين (خلال 3 سنوات).">
      <bpmn:incoming>Flow_5_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_9_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UploadScope" name="Upload project scope (template)" ph:nameEn="Upload project scope (template)" ph:nameAr="رفع نطاق المشروع (النموذج)" ph:descriptionEn="Download the Project Scope template, complete it and upload it. The Administration Department is notified by email to collect quotations." ph:descriptionAr="تنزيل نموذج نطاق المشروع وتعبئته ورفعه، ويتم إشعار إدارة الشؤون الإدارية بالبريد الإلكتروني لجمع عروض الأسعار.">
      <bpmn:incoming>Flow_6_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_7_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Quotations" name="Collect and upload supplier quotations" ph:nameEn="Collect and upload supplier quotations" ph:nameAr="جمع عروض أسعار الموردين ورفعها" ph:descriptionEn="Open the request from the email link, use Upload Quotations to attach all quotations with a comment. Status becomes Quotations Uploaded and the request returns to the requester." ph:descriptionAr="فتح الطلب من رابط البريد الإلكتروني واستخدام إجراء رفع عروض الأسعار لإرفاق جميع العروض مع تعليق. تتغير الحالة إلى تم رفع العروض ويعود الطلب إلى مقدم الطلب.">
      <bpmn:incoming>Flow_7_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_8_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Submit" name="Complete budget details and submit for approval" ph:nameEn="Complete budget details and submit for approval" ph:nameAr="استكمال تفاصيل الميزانية والإرسال للاعتماد" ph:descriptionEn="Fill the budget breakdown, cost sharing, operating costs and expected financial return, then Submit for Approval with a comment. Also used to resubmit after a return for correction." ph:descriptionAr="تعبئة تفاصيل الميزانية والتكاليف المشتركة والتكاليف التشغيلية والعائد المالي المتوقع، ثم الإرسال للاعتماد مع تعليق. تُستخدم أيضًا لإعادة الإرسال بعد الإرجاع للتصحيح.">
      <bpmn:incoming>Flow_8_PMS01</bpmn:incoming>
      <bpmn:incoming>Flow_9_PMS01</bpmn:incoming>
      <bpmn:incoming>Flow_13_PMS01</bpmn:incoming>
      <bpmn:incoming>Flow_17_PMS01</bpmn:incoming>
      <bpmn:incoming>Flow_21_PMS01</bpmn:incoming>
      <bpmn:incoming>Flow_28_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_10_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SMReview" name="Review request (Section Manager)" ph:nameEn="Review request (Section Manager)" ph:nameAr="مراجعة الطلب (رئيس القسم)" ph:descriptionEn="Check section-level alignment and completeness. Approve, Reject or Return for Correction (comment required)." ph:descriptionAr="التحقق من التوافق على مستوى القسم واكتمال البيانات. اعتماد أو رفض أو إرجاع للتصحيح (التعليق إلزامي).">
      <bpmn:incoming>Flow_10_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_11_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_SM" name="Decision?" ph:nameEn="Decision?" ph:nameAr="القرار؟">
      <bpmn:incoming>Flow_11_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_12_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_13_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_14_PMS01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DDReview" name="Review request (Department Director)" ph:nameEn="Review request (Department Director)" ph:nameAr="مراجعة الطلب (مدير الإدارة)" ph:descriptionEn="Validate departmental priority and resource alignment. Approve, Reject or Return for Correction." ph:descriptionAr="التحقق من أولوية الإدارة وتوافق الموارد. اعتماد أو رفض أو إرجاع للتصحيح.">
      <bpmn:incoming>Flow_12_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_15_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_DD" name="Decision?" ph:nameEn="Decision?" ph:nameAr="القرار؟">
      <bpmn:incoming>Flow_15_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_16_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_18_PMS01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PMOReview" name="Review request (PM Office)" ph:nameEn="Review request (PM Office)" ph:nameAr="مراجعة الطلب (مكتب إدارة المشاريع)" ph:descriptionEn="Check methodology adherence, classification, evaluation score and strategic alignment. Approve, Reject or Return for Correction." ph:descriptionAr="التحقق من الالتزام بالمنهجية والتصنيف ودرجة التقييم والتوافق الاستراتيجي. اعتماد أو رفض أو إرجاع للتصحيح.">
      <bpmn:incoming>Flow_16_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_19_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_PMO" name="Decision?" ph:nameEn="Decision?" ph:nameAr="القرار؟">
      <bpmn:incoming>Flow_19_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_20_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_21_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_22_PMS01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Budget" name="Route by budget" ph:nameEn="Route by budget" ph:nameAr="التوجيه حسب الميزانية" ph:descriptionEn="Routing after PM Office approval: no budget → project created; up to AED 50,000 → Budget Section; above AED 50,000 → DG Office, then Budget Section." ph:descriptionAr="التوجيه بعد اعتماد مكتب إدارة المشاريع: دون ميزانية ← إنشاء المشروع؛ حتى 50,000 درهم ← قسم الموازنة؛ أكثر من 50,000 درهم ← مكتب المدير العام ثم قسم الموازنة.">
      <bpmn:incoming>Flow_20_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_23_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_24_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_25_PMS01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DGOReview" name="Endorse program (DG Office)" ph:nameEn="Endorse program (DG Office)" ph:nameAr="اعتماد البرنامج (مكتب المدير العام)" ph:descriptionEn="Strategic endorsement of programs above AED 50,000. Approve, or return for correction." ph:descriptionAr="الاعتماد الاستراتيجي للبرامج التي تزيد عن 50,000 درهم. اعتماد أو إرجاع للتصحيح.">
      <bpmn:incoming>Flow_25_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_26_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_DGO" name="Decision?" ph:nameEn="Decision?" ph:nameAr="القرار؟">
      <bpmn:incoming>Flow_26_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_27_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_28_PMS01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BudgetReview" name="Confirm budget availability" ph:nameEn="Confirm budget availability" ph:nameAr="تأكيد توفر الميزانية" ph:descriptionEn="Validate financial feasibility and record the Approved Budget. Approve or Reject." ph:descriptionAr="التحقق من الجدوى المالية وتسجيل الميزانية المعتمدة. اعتماد أو رفض.">
      <bpmn:incoming>Flow_24_PMS01</bpmn:incoming>
      <bpmn:incoming>Flow_27_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_29_PMS01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_BudgetDecision" name="Decision?" ph:nameEn="Decision?" ph:nameAr="القرار؟">
      <bpmn:incoming>Flow_29_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_30_PMS01</bpmn:outgoing>
      <bpmn:outgoing>Flow_31_PMS01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Service_CreateProject" name="Create Project / Initiative record" ph:nameEn="Create Project / Initiative record" ph:nameAr="إنشاء سجل المشروع / المبادرة" ph:descriptionEn="PMS Project created automatically (ID PROJ-SPMO-YYYY-NNN), stage Initiation, linked to the request." ph:descriptionAr="يُنشأ المشروع تلقائيًا (الرقم PROJ-SPMO-YYYY-NNN) في مرحلة البدء ومرتبطًا بالطلب.">
      <bpmn:incoming>Flow_23_PMS01</bpmn:incoming>
      <bpmn:incoming>Flow_30_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_32_PMS01</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_NotifyRequester" name="Notify requester (bilingual email)" ph:nameEn="Notify requester (bilingual email)" ph:nameAr="إشعار مقدم الطلب (بريد ثنائي اللغة)" ph:descriptionEn="Approval outcome and link to the new project, in English and Arabic." ph:descriptionAr="نتيجة الاعتماد ورابط المشروع الجديد باللغتين العربية والإنجليزية.">
      <bpmn:incoming>Flow_32_PMS01</bpmn:incoming>
      <bpmn:outgoing>Flow_33_PMS01</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Created" name="Project / Initiative created" ph:nameEn="Project / Initiative created" ph:nameAr="تم إنشاء المشروع / المبادرة" ph:descriptionEn="Continues in Project Initiation (Charter)." ph:descriptionAr="يستمر في مرحلة بدء المشروع (الميثاق).">
      <bpmn:incoming>Flow_33_PMS01</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected_SM" name="Request rejected" ph:nameEn="Request rejected" ph:nameAr="رفض الطلب" ph:descriptionEn="Request is closed as Rejected; the requester is notified with the reason." ph:descriptionAr="يُغلق الطلب بحالة مرفوض ويتم إشعار مقدم الطلب بالسبب.">
      <bpmn:incoming>Flow_14_PMS01</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_Rejected_SM_ed" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected_DD" name="Request rejected" ph:nameEn="Request rejected" ph:nameAr="رفض الطلب" ph:descriptionEn="Request is closed as Rejected; the requester is notified with the reason." ph:descriptionAr="يُغلق الطلب بحالة مرفوض ويتم إشعار مقدم الطلب بالسبب.">
      <bpmn:incoming>Flow_18_PMS01</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_Rejected_DD_ed" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected_PMO" name="Request rejected" ph:nameEn="Request rejected" ph:nameAr="رفض الطلب" ph:descriptionEn="Request is closed as Rejected; the requester is notified with the reason." ph:descriptionAr="يُغلق الطلب بحالة مرفوض ويتم إشعار مقدم الطلب بالسبب.">
      <bpmn:incoming>Flow_22_PMS01</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_Rejected_PMO_ed" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected_BudgetDecision" name="Request rejected" ph:nameEn="Request rejected" ph:nameAr="رفض الطلب" ph:descriptionEn="Request is closed as Rejected; the requester is notified with the reason." ph:descriptionAr="يُغلق الطلب بحالة مرفوض ويتم إشعار مقدم الطلب بالسبب.">
      <bpmn:incoming>Flow_31_PMS01</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_Rejected_BudgetDecision_ed" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1_PMS01" sourceRef="Start_Need" targetRef="Task_CreateRequest" />
    <bpmn:sequenceFlow id="Flow_2_PMS01" sourceRef="Task_CreateRequest" targetRef="Task_Screening" />
    <bpmn:sequenceFlow id="Flow_3_PMS01" sourceRef="Task_Screening" targetRef="Service_Classify" />
    <bpmn:sequenceFlow id="Flow_4_PMS01" sourceRef="Service_Classify" targetRef="Gw_CostFile" />
    <bpmn:sequenceFlow id="Flow_5_PMS01" sourceRef="Gw_CostFile" targetRef="Task_UploadCost" name="Yes" ph:nameEn="Yes" ph:nameAr="نعم" />
    <bpmn:sequenceFlow id="Flow_6_PMS01" sourceRef="Gw_CostFile" targetRef="Task_UploadScope" name="No" ph:nameEn="No" ph:nameAr="لا" />
    <bpmn:sequenceFlow id="Flow_7_PMS01" sourceRef="Task_UploadScope" targetRef="Task_Quotations" />
    <bpmn:sequenceFlow id="Flow_8_PMS01" sourceRef="Task_Quotations" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_9_PMS01" sourceRef="Task_UploadCost" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_10_PMS01" sourceRef="Task_Submit" targetRef="Task_SMReview" />
